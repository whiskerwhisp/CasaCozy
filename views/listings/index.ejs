<% layout("/layouts/boilerplate") %>
        <body>
        <!-- Hero Section -->
        <div class="hero-section">
            <div class="container">
                <h2 class="mt-2">🏠 Cozy Spaces</h2>
                <p class="hero-subtitle">Discover amazing stays and create unforgettable memories</p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="container">
            <!-- Filters Section -->
            <div id="filters">
        <div class="filter">
            <div><i class="fa-solid fa-fire"></i>
                <p>Trending</p>
            </div>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-bed"></i>
                <p>Rooms</p>
            </div>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-mountain-city"></i>
                <p>Skyline</p>
            </div>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-mountain"></i>
                <p>Peaks</p>
            </div>
        </div>
        <div class="filter">
            <div><i class="fa-brands fa-fort-awesome"></i>
                <p>Fortress</p>
            </div>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-cow"></i>
                <p>Countryside</p>
            </div>
        </div>
        <div class="filter">
            <div><i class="fa-regular fa-snowflake"></i>
                <p>Frost</p>
            </div>
        </div>
        <div class="filter">
            <div>  <i class="fa-solid fa-person-swimming"></i>
                <p>Amazing Pools</p>
            </div>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-igloo"></i>
                <p>Dome</p>
            </div>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-sailboat"></i>
                <p>Boat</p>
            </div>
        </div>
            <div class="toggle-switch">
                <div class="form-check-reverse form-switch ">
                    <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
                    <label class="form-check-label" for="flexSwitchCheckDefault">Tax-Inclusive Total</label>
                  </div>
            </div>
            
            <!-- Listings Grid -->
            <% if (allListings.length === 0) { %>
                <div class="empty-state text-center py-5">
                    <div class="empty-icon mb-4">
                        <i class="fas fa-home fa-5x text-muted"></i>
                    </div>
                    <h3 class="text-muted mb-3">No cozy spaces found yet</h3>
                    <p class="text-muted mb-4">Be the first to create an amazing listing!</p>
                    <a href="/listings/new" class="btn btn-primary btn-lg">
                        <i class="fas fa-plus me-2"></i>Host a Stay
                    </a>
                </div>
            <% } else { %>
                <div class="listings-header">
                    <h3 class="text-gradient mb-0">
                        <i class="fas fa-home me-2"></i>
                        Available Stays (<%= allListings.length %>)
                    </h3>
                </div>
                
                <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
                    <% for (let listing of allListings){%>
                        <div class="col mb-4">
                            <a href="/listings/<%= listing._id %>" class="listing-link">
                                <div class="card listing-card">
                                    <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>">
                                    <div class="card-img-overlay">
                                        <div class="price-badge">
                                            $<%= listing.price.toLocaleString('en-US') %>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <p class="card-text">
                                            <b><%= listing.title %></b><br>
                                            <i class="fas fa-map-marker-alt me-1"></i>
                                            <%= listing.location %>, <%= listing.country %><br>
                                            $<%= listing.price.toLocaleString('en-US') %>/night 
                                            <span class="tax-info">+10% GST</span>
                                        </p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    <% } %>
                </div>
            <% } %>
        </div>
    </body>
    